<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='; frame-src https://www.youtube.com https://www.youtube-nocookie.com"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            /*background: url('assets/images/backgrounds/<%=bkid%>.jpg') no-repeat center center fixed;*/
            transition: background-image 1s ease;
            background-image: url('data:image/jpeg;base64,');
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: 100%;
            background: #171615;
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <div id="main">
        <div id="distributionNotice" data-state="hidden" role="status" aria-live="polite" aria-atomic="true" aria-hidden="true">
            <span id="distributionNoticeIcon" aria-hidden="true">!</span>
            <span id="distributionNoticeMessage"></span>
            <div id="distributionNoticeActions">
                <button id="distributionNoticeRetry" type="button"></button>
                <button id="distributionNoticeClose" type="button" aria-label="">×</button>
            </div>
        </div>
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <div id="launcherShell" style="display: none;">
            <%- include('sidebar') %>
            <div id="launcherMain">
                <div id="launch_details" role="status" aria-live="polite" aria-atomic="true" aria-hidden="true">
                    <div id="launch_details_right">
                        <div id="launch_details_summary">
                            <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                            <span id="launch_progress_label" aria-hidden="true">0%</span>
                        </div>
                        <progress id="launch_progress" value="0" max="100" aria-labelledby="launch_details_text"></progress>
                    </div>
                </div>
                <%- include('settings') %>
                <%- include('landing') %>
            </div>
        </div>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/LoadingSeal.png">
                <img id="loadSpinnerImage" class="rotating" src="assets/images/LoadingText.png">
            </div>
        </div>
    </div>
</body>
</html>
