<div id="landingContainer" style="display: none;">
    <section id="launcherWorkspace">
        <header id="launcherHomeHeader" hidden>
            <span id="launcherHomeEyebrow">MAPLECRAFT</span>
            <h1 id="launcherHomeTitle"><%- lang('landing.homeTitle') %></h1>
        </header>
        <header id="launcherGameHeader">
            <span id="launcherGameEyebrow">MAPLECRAFT</span>
            <nav id="launcherGameTabs" role="tablist" aria-label="<%- lang('landing.tabsAriaLabel') %>">
                <button id="landingPlayButton" class="launcherGameTab" type="button" role="tab" aria-controls="landingPlayView" aria-selected="true" tabindex="0" selected><%- lang('landing.navPlay') %></button>
                <button id="landingModsButton" class="launcherGameTab" type="button" role="tab" aria-controls="landingModsView" aria-selected="false" tabindex="-1"><%- lang('landing.navMods') %></button>
                <button id="landingJavaButton" class="launcherGameTab" type="button" role="tab" aria-controls="landingJavaView" aria-selected="false" tabindex="-1"><%- lang('landing.navJava') %></button>
                <button id="landingUpdatesButton" class="launcherGameTab" type="button" role="tab" aria-controls="newsContainer" aria-selected="false" tabindex="-1"><%- lang('landing.navUpdates') %></button>
            </nav>
        </header>

        <div id="landingWorkspaceScroll">
            <section id="landingHomeView" class="landingSectionView" aria-labelledby="landingHomeButton" aria-hidden="true" hidden>
                <header id="landingHomeContentHeader">
                    <span><%- lang('landing.navWhatsNew') %></span>
                    <h2><%- lang('landing.globalNewsTitle') %></h2>
                    <p><%- lang('landing.homeDescription') %></p>
                </header>
                <div id="globalNewsCards" class="newsCardGrid" aria-live="polite">
                    <div class="newsPreviewState"><%- lang('landing.newsErrorLoadSpan') %></div>
                </div>
            </section>

            <section id="globalNewsContainer" class="landingSectionView newsFullView" aria-labelledby="newsButton" aria-hidden="true" hidden>
                <div class="newsFullHeader">
                    <div>
                        <span>MAPLECRAFT</span>
                        <h1><%- lang('landing.globalNewsTitle') %></h1>
                    </div>
                    <button id="globalNewsBackButton" class="mcButtonSecondary" type="button"><%- lang('landing.backToHome') %></button>
                </div>
                <div id="globalNewsContent" class="newsFullContent" data-news-content article="-1" style="display: none;">
                    <div class="newsFullStatusContainer" data-news-status>
                        <div class="newsFullStatusContent">
                            <div class="newsFullTitleContainer">
                                <a id="globalNewsArticleTitle" class="newsFullArticleTitle" data-news-title>Lorem Ipsum</a>
                            </div>
                            <div class="newsFullMetaContainer">
                                <span id="globalNewsArticleDate" data-news-date></span>
                                <span id="globalNewsArticleAuthor" data-news-author></span>
                                <a id="globalNewsArticleComments" class="newsFullArticleComments" data-news-comments></a>
                            </div>
                        </div>
                        <div class="newsFullNavigationContainer">
                            <button id="globalNewsNavigateLeft" class="newsFullNavigateButton" data-news-previous type="button" aria-label="Previous">‹</button>
                            <span id="globalNewsNavigationStatus" data-news-navigation><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                            <button id="globalNewsNavigateRight" class="newsFullNavigateButton" data-news-next type="button" aria-label="Next">›</button>
                        </div>
                    </div>
                    <div class="newsFullArticleContainer">
                        <div class="newsFullArticleContent">
                            <div id="globalNewsArticleContentScrollable" class="newsFullArticleScrollable" data-news-article></div>
                        </div>
                    </div>
                </div>
                <div id="globalNewsErrorContainer" class="newsFullErrorContainer" data-news-errors>
                    <div class="newsFullErrorLoading" data-news-loading>
                        <span class="newsErrorContent" data-news-loading-label><%- lang('landing.newsErrorLoadSpan') %></span>
                    </div>
                    <div class="newsFullErrorFailed" data-news-failed style="display: none;">
                        <span class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                        <button id="globalNewsErrorRetry" class="mcButtonSecondary" data-news-retry type="button"><%- lang('landing.newsErrorRetryButton') %></button>
                    </div>
                    <div data-news-empty style="display: none;">
                        <span class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                    </div>
                </div>
            </section>

            <main id="landingPlayView" class="landingSectionView" role="tabpanel" aria-labelledby="landingPlayButton">
                <section id="launcherHero" data-default-background="assets/images/backgrounds/<%=bkid%>.jpg" style="background-image: url('assets/images/backgrounds/<%=bkid%>.jpg');">
                    <video id="launcherHeroVideo" loop playsinline preload="metadata" aria-hidden="true"></video>
                    <div id="launcherHeroYouTube" aria-hidden="true"></div>
                    <div id="launcherHeroShade"></div>
                    <div id="image_seal_container">
                        <img id="image_seal" src="assets/images/Maple.png" alt="MapleCraft"/>
                        <div id="launcherHeroWordmark">MAPLECRAFT</div>
                        <div id="launcherHeroTagline"><%- lang('landing.heroTagline') %></div>
                    </div>
                    <div id="launcherHeroMediaControls" hidden>
                        <button id="launcherHeroPlayToggle" type="button" aria-pressed="true" aria-label="<%- lang('landing.heroVideo.pause') %>">Ⅱ</button>
                        <button id="launcherHeroMuteToggle" type="button" aria-pressed="true" aria-label="<%- lang('landing.heroVideo.unmute') %>">🔇</button>
                        <span id="launcherHeroMediaStatus" role="status" aria-live="polite"></span>
                    </div>
                </section>

                <section id="launcherActionBar">
                    <button id="server_selection_button" type="button" aria-label="<%- lang('landing.navServers') %>">
                        <img id="selectedServerIcon" src="assets/images/SealCircle.png" alt=""/>
                        <span id="selectedServerCopy">
                            <span id="selectedServerLabel"><%- lang('landing.selectedServerLabel') %></span>
                            <span id="selectedServerName"><%- lang('landing.launchButtonPlaceholder') %></span>
                            <span id="selectedServerVersion"></span>
                        </span>
                        <span class="actionChevron" aria-hidden="true">⌄</span>
                    </button>

                    <div id="launch_content">
                        <button id="launch_button" disabled><%- lang('landing.launchButton') %></button>
                    </div>

                    <div id="launcherStatusDock">
                        <div id="server_status_wrapper">
                            <span class="bot_label" id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
                            <span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
                        </div>
                        <div id="mojangStatusWrapper">
                            <span id="mojang_status_icon">●</span>
                            <span class="bot_label"><%- lang('landing.servicesLabel') %></span>
                            <div id="mojangStatusTooltip">
                                <div id="mojangStatusTooltipTitle"><%- lang('landing.mojangStatusTooltipTitle') %></div>
                                <div id="mojangStatusEssentialContainer"></div>
                                <div id="mojangStatusNEContainer">
                                    <div class="mojangStatusNEBar"></div>
                                    <div id="mojangStatusNETitle"><%- lang('landing.mojangStatusNETitle') %></div>
                                    <div class="mojangStatusNEBar"></div>
                                </div>
                                <div id="mojangStatusNonEssentialContainer"></div>
                            </div>
                        </div>
                        <span id="launchAccountCopy">
                            <button id="launchAccountName" type="button" aria-label="<%- lang('landing.copyPlayerName') %>" disabled><%- lang('landing.usernamePlaceholder') %></button>
                            <span id="launchAccountCopyFeedback" role="status" aria-live="polite" aria-atomic="true"></span>
                        </span>
                    </div>
                </section>

                <section id="newsPreviewSection">
                    <div id="newsPreviewHeader">
                        <div>
                            <span id="newsPreviewEyebrow"><%- lang('landing.navWhatsNew') %></span>
                            <h2 id="newsPreviewTitle"><%- lang('landing.newsPreviewTitle') %></h2>
                        </div>
                        <button id="newsPreviewAction" class="mcButtonSecondary" type="button"><%- lang('landing.newsPreviewAction') %></button>
                    </div>
                    <div id="newsCards" class="newsCardGrid" aria-live="polite">
                        <div class="newsPreviewState"><%- lang('landing.newsErrorLoadSpan') %></div>
                    </div>
                </section>
            </main>

            <section id="landingModsView" class="landingSectionView" role="tabpanel" aria-labelledby="landingModsButton" aria-hidden="true" hidden>
                <header id="landingModsHeader">
                    <h1><%- lang('landing.modsTitle') %></h1>
                    <p><%- lang('landing.modsDescription') %></p>
                </header>
                <div id="landingModsStatus" role="status" aria-live="polite">
                    <span id="landingModsStatusText"><%- lang('landing.modsLoading') %></span>
                    <button id="landingModsRetryButton" class="mcButtonSecondary" type="button" hidden><%- lang('landing.modsRetry') %></button>
                </div>
                <div id="landingModsContent" hidden>
                    <section id="landingModsServer" aria-label="<%- lang('landing.modsSelectedServer') %>">
                        <img id="landingModsServerIcon" src="assets/images/SealCircle.png" alt=""/>
                        <span id="landingModsServerCopy">
                            <span id="landingModsServerLabel"><%- lang('landing.modsSelectedServer') %></span>
                            <strong id="landingModsServerName"></strong>
                            <span id="landingModsServerVersion"></span>
                        </span>
                        <span id="landingModsServerHint"><%- lang('landing.modsSwitchHint') %></span>
                    </section>
                    <div id="landingModsEmpty" role="status" hidden><%- lang('landing.modsEmpty') %></div>
                    <div id="settingsModsContainer">
                        <section id="settingsReqModsContainer">
                            <h2 class="settingsModsHeader"><%- lang('landing.modsRequired') %></h2>
                            <div id="settingsReqModsContent"></div>
                        </section>
                        <section id="settingsOptModsContainer">
                            <h2 class="settingsModsHeader"><%- lang('landing.modsOptional') %></h2>
                            <div id="settingsOptModsContent"></div>
                        </section>
                        <section id="settingsDropinModsContainer">
                            <h2 class="settingsModsHeader"><%- lang('landing.modsDropin') %></h2>
                            <button id="settingsDropinFileSystemButton" class="mcButtonSecondary mcButtonWide" type="button"><%- lang('landing.modsAdd') %> <span id="settingsDropinRefreshNote"><%- lang('landing.modsRefreshNote') %></span></button>
                            <div id="settingsDropinModsContent"></div>
                        </section>
                        <section id="settingsShadersContainer">
                            <h2 class="settingsModsHeader"><%- lang('landing.modsShaderpacks') %></h2>
                            <div id="settingsShaderpackDesc"><%- lang('landing.modsShaderpackDesc') %></div>
                            <div id="settingsShaderpackWrapper">
                                <button id="settingsShaderpackButton" class="mcButtonSecondary mcButtonIcon" type="button" aria-label="<%- lang('landing.modsAddShaderpack') %>">+</button>
                                <div class="settingsSelectContainer">
                                    <button class="settingsSelectSelected" id="settingsShadersSelected" type="button" aria-haspopup="listbox" aria-expanded="false"><%- lang('landing.modsSelectShaderpack') %></button>
                                    <div class="settingsSelectOptions" id="settingsShadersOptions" role="listbox" hidden></div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </section>

            <%- include('java') %>

            <section id="newsContainer" class="landingSectionView newsFullView" role="tabpanel" aria-labelledby="landingUpdatesButton" aria-hidden="true" hidden>
                <div id="newsViewHeader" class="newsFullHeader">
                    <div>
                        <span id="newsViewEyebrow">MAPLECRAFT</span>
                        <h1 id="newsViewTitle"><%- lang('landing.navUpdates') %></h1>
                    </div>
                    <button id="newsBackButton" class="mcButtonSecondary" type="button"><%- lang('landing.backToPlay') %></button>
                </div>
                <div id="newsContent" class="newsFullContent" data-news-content article="-1" style="display: none;">
                    <div id="newsStatusContainer" class="newsFullStatusContainer" data-news-status>
                        <div id="newsStatusContent" class="newsFullStatusContent">
                            <div id="newsTitleContainer" class="newsFullTitleContainer">
                                <a id="newsArticleTitle" class="newsFullArticleTitle" data-news-title>Lorem Ipsum</a>
                            </div>
                            <div id="newsMetaContainer" class="newsFullMetaContainer">
                                <span id="newsArticleDate" data-news-date></span>
                                <span id="newsArticleAuthor" data-news-author></span>
                                <a id="newsArticleComments" class="newsFullArticleComments" data-news-comments></a>
                            </div>
                        </div>
                        <div id="newsNavigationContainer" class="newsFullNavigationContainer">
                            <button id="newsNavigateLeft" class="newsFullNavigateButton" data-news-previous type="button" aria-label="Previous">‹</button>
                            <span id="newsNavigationStatus" data-news-navigation><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                            <button id="newsNavigateRight" class="newsFullNavigateButton" data-news-next type="button" aria-label="Next">›</button>
                        </div>
                    </div>
                    <div id="newsArticleContainer" class="newsFullArticleContainer">
                        <div id="newsArticleContent" class="newsFullArticleContent">
                            <div id="newsArticleContentScrollable" class="newsFullArticleScrollable" data-news-article></div>
                        </div>
                    </div>
                </div>
                <div id="newsErrorContainer" class="newsFullErrorContainer" data-news-errors>
                    <div id="newsErrorLoading" class="newsFullErrorLoading" data-news-loading>
                        <span id="nELoadSpan" class="newsErrorContent" data-news-loading-label><%- lang('landing.newsErrorLoadSpan') %></span>
                    </div>
                    <div id="newsErrorFailed" class="newsFullErrorFailed" data-news-failed style="display: none;">
                        <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                        <button id="newsErrorRetry" class="mcButtonSecondary" data-news-retry type="button"><%- lang('landing.newsErrorRetryButton') %></button>
                    </div>
                    <div id="newsErrorNone" data-news-empty style="display: none;">
                        <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                    </div>
                </div>
            </section>
        </div>
        <div id="launch_details" role="status" aria-live="polite" aria-atomic="true" aria-hidden="true">
            <div id="launch_details_right">
                <div id="launch_details_summary">
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                    <span id="launch_progress_label" aria-hidden="true">0%</span>
                </div>
                <progress id="launch_progress" value="0" max="100" aria-labelledby="launch_details_text"></progress>
            </div>
        </div>
    </section>
    <script src="./assets/js/scripts/java.js"></script>
    <script src="./assets/js/scripts/mods.js"></script>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
